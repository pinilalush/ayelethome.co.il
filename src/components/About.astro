---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Section from './Section.astro';
import { getLocale, site } from '../lib/data.ts';
import { findImage } from '../lib/media.ts';
import type { Tone } from '../lib/sections.ts';

interface Props {
	code: string;
	tone?: Tone;
}

const { code, tone = 'surface' } = Astro.props;
const { content, ui } = getLocale(code);
const photo = findImage(site.media.about.file);
const photoAlt = content.media[site.media.about.alt] ?? content.ownerName;
const initial = [...content.ownerName.trim()][0] ?? '';
---

<Section id="why" title={ui.sections.why} tone={tone}>
	<div class="about">
		<div class="about__visual">
			{
				photo ? (
					<Image
						src={photo}
						alt={photoAlt}
						widths={[360, 540, 720, 960]}
						sizes="(min-width: 56rem) 40vw, min(100vw, 26rem)"
						class="about__photo"
						loading="lazy"
					/>
				) : (
					<div class="about__placeholder" aria-hidden="true">
						<span class="about__initial">{initial}</span>
						<span class="about__sparkle about__sparkle--a">
							<Icon name="sparkle" size="100%" />
						</span>
						<span class="about__sparkle about__sparkle--b">
							<Icon name="sparkle" size="100%" />
						</span>
					</div>
				)
			}
		</div>

		<div class="about__text">
			<h3 class="about__title">{content.about.title}</h3>
			<p class="about__body">{content.about.text}</p>
			<p class="about__signature">{content.ownerName}</p>

			<ul class="points">
				{
					content.why.map((point) => (
						<li class="point">
							<span class="point__icon" aria-hidden="true">
								<Icon name={point.icon} size="1.4rem" />
							</span>
							<div>
								<h3 class="point__title">{point.title}</h3>
								<p class="point__text">{point.text}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</Section>

<style>
	.about {
		display: grid;
		gap: var(--space-xl);
		max-inline-size: 64rem;
		margin-inline: auto;
	}

	@media (min-width: 56rem) {
		.about {
			grid-template-columns: 0.85fr 1.15fr;
			align-items: center;
		}
	}

	.about__visual {
		position: relative;
		inline-size: min(100%, 26rem, 75svh);
		margin-inline: auto;
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: calc(var(--radius) * 2);
		box-shadow: 0 2rem 4rem -2.5rem color-mix(in oklab, var(--color-ink) 55%, transparent);
	}

	@media (min-width: 56rem) {
		.about__visual {
			inline-size: min(100%, 64svh);
			aspect-ratio: 4 / 5;
		}
	}

	.about__photo {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}

	.about__placeholder {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background:
			radial-gradient(70% 55% at 75% 20%, color-mix(in oklab, var(--color-accent) 45%, transparent), transparent 70%),
			linear-gradient(160deg, var(--color-ink), color-mix(in oklab, var(--color-primary) 70%, var(--color-ink)));
		color: var(--color-surface);
	}

	.about__initial {
		font-size: clamp(6rem, 4rem + 8vw, 10rem);
		font-weight: 800;
		line-height: 1;
		opacity: 0.92;
	}

	.about__sparkle {
		position: absolute;
		color: var(--color-accent);
	}

	.about__sparkle--a {
		inset-block-start: 14%;
		inset-inline-end: 16%;
		inline-size: 12%;
	}

	.about__sparkle--b {
		inset-block-end: 16%;
		inset-inline-start: 14%;
		inline-size: 8%;
		opacity: 0.8;
	}

	.about__text {
		display: grid;
		gap: var(--space-s);
	}

	.about__title {
		font-size: var(--step-3);
	}

	.about__body {
		font-size: var(--step-1);
		color: var(--color-text-muted);
	}

	.about__signature {
		color: color-mix(in oklab, var(--color-primary) 65%, var(--color-ink));
		font-size: var(--step-1);
		font-weight: 700;
	}

	.points {
		display: grid;
		gap: var(--space-s);
		margin: var(--space-xs) 0 0;
		padding: 0;
		list-style: none;
	}

	.point {
		display: flex;
		align-items: flex-start;
		gap: var(--space-s);
		padding: var(--space-s);
		border: 1px solid color-mix(in oklab, var(--color-text) 8%, transparent);
		border-radius: var(--radius);
		background: var(--color-surface-alt);
	}

	.point__icon {
		display: grid;
		flex: none;
		place-items: center;
		inline-size: 2.75rem;
		block-size: 2.75rem;
		border-radius: calc(var(--radius) * 0.7);
		background: var(--color-surface);
		color: color-mix(in oklab, var(--color-primary) 65%, var(--color-ink));
	}

	.point__title {
		font-size: var(--step-0);
		font-weight: 700;
		line-height: 1.3;
	}

	.point__text {
		color: var(--color-text-muted);
		font-size: var(--step--1);
	}
</style>
