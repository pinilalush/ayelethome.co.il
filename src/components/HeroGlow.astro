---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { telHref, whatsappHref } from '../lib/contact.ts';
import { getLocale, site } from '../lib/data.ts';

interface Props {
	code: string;
}

const { code } = Astro.props;
const { content, ui } = getLocale(code);
const { business } = site;

const sparkles = [
	{ top: '0.5rem', start: '7%', size: '1.5rem', delay: '0s', edge: 'top' },
	{ top: '1.5rem', start: '86%', size: '1.1rem', delay: '-2s', edge: 'top' },
	{ top: '91%', start: '6%', size: '1.1rem', delay: '-4s' },
	{ top: '88%', start: '90%', size: '1.75rem', delay: '-1s' },
	{ top: '56%', start: '97%', size: '0.8rem', delay: '-3s' },
	{ top: '38%', start: '1%', size: '0.7rem', delay: '-5s' },
];
---

<section class="hero" aria-labelledby="hero-title">
	<div class="hero__decor" aria-hidden="true">
		<div class="hero__glow hero__glow--a"></div>
		<div class="hero__glow hero__glow--b"></div>
		<div class="hero__dots"></div>
		{
			sparkles.map((s) => (
				<span
					class:list={['hero__sparkle', s.edge && `hero__sparkle--${s.edge}`]}
					style={`--top:${s.top};--start:${s.start};--size:${s.size};--delay:${s.delay}`}
				>
					<Icon name="sparkle" size="100%" />
				</span>
			))
		}
	</div>

	<div class="container hero__inner">
		<p class="hero__eyebrow">
			<Icon name="sparkle" size="1.1em" />
			<span>{content.tagline}</span>
		</p>
		<h1 id="hero-title" class="hero__title">{content.hero.title}</h1>
		<p class="hero__subtitle">{content.hero.subtitle}</p>
		<div class="hero__actions">
			<Button href={whatsappHref(business.whatsapp)} icon="whatsapp">{ui.bookOnWhatsapp}</Button>
			<Button href={telHref(business.phone)} variant="on-dark" icon="phone">{ui.call}</Button>
		</div>
		<ul class="hero__badges">
			{
				content.hero.badges.map((badge) => (
					<li>
						<Icon name="check" size="1.1em" />
						<span>{badge}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding-block: var(--space-xl) var(--space-3xl);
		background: var(--color-ink);
		color: var(--color-surface);
		text-align: center;
		border-end-start-radius: clamp(1.5rem, 4vw, 3rem);
		border-end-end-radius: clamp(1.5rem, 4vw, 3rem);
	}

	.hero__decor {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		mask-image: linear-gradient(to bottom, transparent, black 18%);
	}

	.hero__glow {
		position: absolute;
		border-radius: 50%;
		filter: blur(40px);
	}

	.hero__glow--a {
		inline-size: 70vmax;
		block-size: 70vmax;
		inset-block-start: -38vmax;
		inset-inline-end: -28vmax;
		background: radial-gradient(circle, color-mix(in oklab, var(--color-accent) 60%, transparent), transparent 65%);
	}

	.hero__glow--b {
		inline-size: 60vmax;
		block-size: 60vmax;
		inset-block-end: -36vmax;
		inset-inline-start: -26vmax;
		background: radial-gradient(circle, color-mix(in oklab, var(--color-primary) 55%, transparent), transparent 65%);
	}

	.hero__dots {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(color-mix(in oklab, var(--color-surface) 22%, transparent) 1px, transparent 1.5px);
		background-size: 26px 26px;
		mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 20%, transparent 75%);
		opacity: 0.6;
	}

	.hero__sparkle {
		position: absolute;
		inset-block-start: var(--top);
		inset-inline-start: var(--start);
		inline-size: var(--size);
		color: var(--color-accent);
		opacity: 0.75;
		animation: hero-float 7s ease-in-out infinite;
		animation-delay: var(--delay);
	}

	@keyframes hero-float {
		0%,
		100% {
			transform: translateY(0) scale(1) rotate(0deg);
			opacity: 0.75;
		}
		50% {
			transform: translateY(-12px) scale(1.12) rotate(10deg);
			opacity: 1;
		}
	}

	.hero__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-m);
	}

	@media (min-width: 56rem) {
		.hero {
			display: grid;
			align-items: center;
			min-block-size: min(46rem, 80svh);
		}
	}

	.hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.45em 1.1em;
		border: 1px solid color-mix(in oklab, var(--color-surface) 18%, transparent);
		border-radius: 999px;
		background: color-mix(in oklab, var(--color-surface) 8%, transparent);
		backdrop-filter: blur(8px);
		color: var(--color-accent);
		font-size: var(--step--1);
		font-weight: 600;
	}

	.hero__title {
		max-inline-size: 18ch;
		font-size: clamp(2.25rem, 1.55rem + 3.5vw, 4.75rem);
		line-height: 1.06;
		letter-spacing: -0.015em;
		background: linear-gradient(180deg, var(--color-surface) 45%, color-mix(in oklab, var(--color-accent) 75%, var(--color-surface)));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	@media (forced-colors: active) {
		.hero__title {
			background: none;
			color: CanvasText;
		}
	}

	.hero__subtitle {
		max-inline-size: 42ch;
		font-size: var(--step-1);
		color: color-mix(in oklab, var(--color-surface) 80%, transparent);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-xs);
		inline-size: 100%;
		margin-block-start: var(--space-2xs);
	}

	.hero__actions > :global(*) {
		flex: 1 1 14rem;
	}

	@media (min-width: 40rem) {
		.hero__actions > :global(*) {
			max-inline-size: 20rem;
		}
	}

	.hero__badges {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-2xs) var(--space-m);
		padding: 0;
		list-style: none;
		color: color-mix(in oklab, var(--color-surface) 85%, transparent);
		font-size: var(--step--1);
		font-weight: 500;
	}

	@media (orientation: landscape) and (max-height: 32rem) {
		.hero {
			padding-block: var(--space-s) var(--space-l);
		}

		.hero__inner {
			gap: var(--space-xs);
		}

		.hero__eyebrow,
		.hero__sparkle--top {
			display: none;
		}

		.hero__title {
			max-inline-size: 26ch;
			font-size: clamp(1.75rem, 1rem + 2.5vw, 2.5rem);
		}

		.hero__subtitle {
			font-size: var(--step-0);
		}

		.hero__actions {
			margin-block-start: 0;
		}

		.hero__actions > :global(*) {
			flex-basis: 12rem;
			max-inline-size: 18rem;
		}
	}

	.hero__badges li {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
	}

	.hero__badges :global(svg) {
		color: var(--color-accent);
	}
</style>
