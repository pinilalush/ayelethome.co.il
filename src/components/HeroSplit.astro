---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { telHref, whatsappHref } from '../lib/contact.ts';
import { getLocale, site } from '../lib/data.ts';
import { findImage } from '../lib/media.ts';

interface Props {
	code: string;
}

const { code } = Astro.props;
const { content, ui } = getLocale(code);
const { business, media } = site;
const photo = findImage(media.hero.file);
const photoAlt = content.media[media.hero.alt] ?? '';
---

<section class="hero" aria-labelledby="hero-title">
	<div class="container hero__inner">
		<div class="hero__text">
			<p class="hero__eyebrow">
				<span class="hero__dot" aria-hidden="true"></span>
				<span>{content.tagline}</span>
			</p>
			<h1 id="hero-title" class="hero__title">{content.hero.title}</h1>
			<p class="hero__subtitle">{content.hero.subtitle}</p>
			<div class="hero__actions">
				<Button href={whatsappHref(business.whatsapp)} icon="whatsapp">{ui.bookOnWhatsapp}</Button>
				<Button href={telHref(business.phone)} variant="secondary" icon="phone">{ui.call}</Button>
			</div>
		</div>

		<div class="hero__visual">
			<div class="hero__frame">
				{
					photo ? (
						<Image
							src={photo}
							alt={photoAlt}
							widths={[480, 720, 960, 1280]}
							sizes="(min-width: 56rem) 45vw, 100vw"
							class="hero__photo"
							loading="eager"
							fetchpriority="high"
						/>
					) : (
						<div class="hero__art" aria-hidden="true">
							<span class="hero__art-window">
								<Icon name="window" size="100%" />
							</span>
							<span class="hero__art-sparkle hero__art-sparkle--a">
								<Icon name="sparkle" size="100%" />
							</span>
							<span class="hero__art-sparkle hero__art-sparkle--b">
								<Icon name="sparkle" size="100%" />
							</span>
						</div>
					)
				}
			</div>
			<ul class="hero__chips">
				{
					content.hero.badges.map((badge) => (
						<li class="hero__chip">
							<span class="hero__chip-icon">
								<Icon name="check" size="0.95em" />
							</span>
							<span>{badge}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: var(--space-l) var(--space-2xl);
		background:
			radial-gradient(55% 45% at 90% 65%, color-mix(in oklab, var(--color-accent) 38%, transparent), transparent 70%),
			radial-gradient(50% 40% at 5% 100%, color-mix(in oklab, var(--color-primary) 14%, transparent), transparent 70%),
			var(--color-surface-alt);
		color: var(--color-text);
	}

	.hero__inner {
		display: grid;
		gap: var(--space-xl);
	}

	@media (min-width: 56rem) {
		.hero__inner {
			grid-template-columns: 1.05fr 0.95fr;
			align-items: center;
			gap: var(--space-2xl);
		}
	}

	.hero__text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-m);
	}

	.hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		padding: 0.45em 1.1em;
		border: 1px solid color-mix(in oklab, var(--color-text) 10%, transparent);
		border-radius: 999px;
		background: var(--color-surface);
		font-size: var(--step--1);
		font-weight: 600;
	}

	.hero__dot {
		inline-size: 0.55em;
		block-size: 0.55em;
		border-radius: 50%;
		background: var(--color-primary);
		box-shadow: 0 0 0 0.3em color-mix(in oklab, var(--color-primary) 22%, transparent);
	}

	.hero__title {
		max-inline-size: 16ch;
		font-size: clamp(2.25rem, 1.55rem + 3.5vw, 4.5rem);
		line-height: 1.06;
		letter-spacing: -0.015em;
	}

	.hero__subtitle {
		max-inline-size: 40ch;
		font-size: var(--step-1);
		color: var(--color-text-muted);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		inline-size: 100%;
		margin-block-start: var(--space-2xs);
	}

	.hero__actions > :global(*) {
		flex: 1 1 12rem;
	}

	@media (min-width: 40rem) {
		.hero__actions > :global(*) {
			max-inline-size: 18rem;
		}
	}

	.hero__visual {
		position: relative;
	}

	.hero__frame {
		position: relative;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		border-radius: calc(var(--radius) * 2);
		box-shadow: 0 2rem 4rem -2rem color-mix(in oklab, var(--color-ink) 45%, transparent);
	}

	@media (min-width: 56rem) {
		.hero__frame {
			aspect-ratio: 4 / 5;
		}
	}

	.hero__photo {
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}

	.hero__art {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background:
			radial-gradient(70% 60% at 30% 20%, color-mix(in oklab, var(--color-surface) 45%, transparent), transparent 70%),
			linear-gradient(150deg, var(--color-accent), var(--color-primary));
		color: var(--color-surface);
	}

	.hero__art-window {
		inline-size: 38%;
		opacity: 0.95;
	}

	.hero__art-sparkle {
		position: absolute;
		color: var(--color-surface);
	}

	.hero__art-sparkle--a {
		inset-block-start: 16%;
		inset-inline-end: 18%;
		inline-size: 14%;
	}

	.hero__art-sparkle--b {
		inset-block-end: 20%;
		inset-inline-start: 16%;
		inline-size: 9%;
		opacity: 0.8;
	}

	.hero__chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2xs);
		margin-block-start: var(--space-s);
		padding: 0;
		list-style: none;
	}

	.hero__chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding-block: 0.5em;
		padding-inline: 0.6em 1em;
		border: 1px solid color-mix(in oklab, var(--color-text) 8%, transparent);
		border-radius: 999px;
		background: color-mix(in oklab, var(--color-surface) 88%, transparent);
		backdrop-filter: blur(10px);
		box-shadow: 0 0.75rem 1.5rem -1rem color-mix(in oklab, var(--color-ink) 40%, transparent);
		font-size: var(--step--1);
		font-weight: 600;
	}

	.hero__chip-icon {
		display: grid;
		place-items: center;
		inline-size: 1.6em;
		block-size: 1.6em;
		border-radius: 50%;
		background: var(--color-primary);
		color: var(--color-primary-text);
	}

	@media (min-width: 56rem) {
		.hero__chips {
			position: absolute;
			inset: 0;
			display: block;
			margin: 0;
			pointer-events: none;
		}

		.hero__chip {
			position: absolute;
			pointer-events: auto;
		}

		.hero__chip:nth-child(1) {
			inset-block-start: 10%;
			inset-inline-start: -1.5rem;
		}

		.hero__chip:nth-child(2) {
			inset-block-start: 46%;
			inset-inline-end: -1rem;
		}

		.hero__chip:nth-child(3) {
			inset-block-end: 10%;
			inset-inline-start: -0.5rem;
		}
	}
</style>
