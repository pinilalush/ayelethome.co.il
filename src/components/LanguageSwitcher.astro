---
import { getLocale, site } from '../lib/data.ts';
import { LANGUAGE_STORAGE_KEY, homeUrl } from '../lib/i18n.ts';

interface Props {
	current: string;
}

const { current } = Astro.props;
const { ui } = getLocale(current);
---

<nav aria-label={ui.languageSwitcher} data-language-switcher data-storage-key={LANGUAGE_STORAGE_KEY}>
	<ul>
		{
			site.languages.map((l) => (
				<li>
					<a
						href={homeUrl(l.code)}
						lang={l.code}
						hreflang={l.code}
						data-lang={l.code}
						aria-current={l.code === current ? 'page' : undefined}
					>
						{l.name}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3xs);
		padding: 0;
		list-style: none;
	}

	a {
		display: inline-flex;
		align-items: center;
		min-block-size: 2.75rem;
		min-inline-size: 2.75rem;
		justify-content: center;
		padding-inline: var(--space-xs);
		border-radius: 999px;
		font-size: var(--step--1);
		font-weight: 500;
		text-decoration: none;
		color: var(--color-text-muted);
	}

	a:hover {
		color: var(--color-text);
		background: var(--color-surface-alt);
	}

	a[aria-current='page'] {
		color: var(--color-text);
		font-weight: 700;
		background: var(--color-surface-alt);
	}
</style>

<script>
	for (const nav of document.querySelectorAll<HTMLElement>('[data-language-switcher]')) {
		nav.addEventListener('click', (event) => {
			const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-lang]');
			const key = nav.dataset.storageKey;
			if (!link?.dataset.lang || !key) return;
			try {
				localStorage.setItem(key, link.dataset.lang);
			} catch {}
		});
	}
</script>
