---
import Icon from './Icon.astro';
import { getLocale, site } from '../lib/data.ts';
import { homeUrl } from '../lib/i18n.ts';
import { findImage } from '../lib/media.ts';

interface Props {
	code: string;
}

const { code } = Astro.props;
const { content } = getLocale(code);

const logoData = site.media.logo;
const logo = findImage(logoData?.file);
const alt = (logoData && content.media[logoData.alt]) ?? content.businessName;
---

<a href={homeUrl(code)} class="logo">
	{
		logo ? (
			<img src={logo.src} width={logo.width} height={logo.height} alt={alt} class="logo__image" />
		) : (
			<>
				<span class="logo__mark" aria-hidden="true">
					<Icon name="sparkle" size="1.4rem" />
				</span>
				<span class="logo__name">{content.businessName}</span>
			</>
		)
	}
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		min-block-size: 2.75rem;
		color: var(--color-text);
		font-size: var(--step-1);
		font-weight: 800;
		line-height: 1.1;
		text-decoration: none;
	}

	.logo__mark {
		display: grid;
		place-items: center;
		flex: none;
		inline-size: 2.25rem;
		block-size: 2.25rem;
		border-radius: calc(var(--radius) * 0.6);
		background: var(--color-primary);
		color: var(--color-primary-text);
	}

	.logo__image {
		block-size: 2.5rem;
		inline-size: auto;
	}
</style>
