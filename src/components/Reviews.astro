---
import Icon from './Icon.astro';
import Section from './Section.astro';
import { getLocale } from '../lib/data.ts';
import type { Tone } from '../lib/sections.ts';

interface Props {
	code: string;
	tone?: Tone;
}

const { code, tone = 'alt' } = Astro.props;
const { content, ui } = getLocale(code);
const month = new Intl.DateTimeFormat(code, { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Section id="reviews" title={ui.sections.reviews} tone={tone}>
	<ul class="reviews">
		{
			content.reviews.map((review) => (
				<li class="review">
					<figure class="review__figure">
						<Icon name="quote" size="2rem" class="review__mark" />
						<blockquote class="review__text">
							<p>{review.text}</p>
						</blockquote>
						<figcaption class="review__author">
							<span class="review__initial" aria-hidden="true">
								{[...review.name.trim()][0]}
							</span>
							<span>
								<span class="review__name">{review.name}</span>
								<span class="review__meta">
									{review.area} · <time datetime={review.date}>{month.format(new Date(review.date))}</time>
								</span>
							</span>
						</figcaption>
					</figure>
				</li>
			))
		}
	</ul>
</Section>

<style>
	.reviews {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
		gap: var(--space-s);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.review {
		display: flex;
		padding: var(--space-m);
		border: 1px solid color-mix(in oklab, var(--color-text) 9%, transparent);
		border-radius: calc(var(--radius) * 1.2);
		background: var(--color-surface);
		box-shadow: 0 1rem 2.5rem -2rem color-mix(in oklab, var(--color-ink) 50%, transparent);
	}

	.review__figure {
		display: flex;
		flex-direction: column;
		gap: var(--space-s);
		inline-size: 100%;
	}

	.review__figure :global(.review__mark) {
		color: color-mix(in oklab, var(--color-primary) 55%, var(--color-surface));
	}

	.review__text {
		flex: 1;
		margin: 0;
		font-size: var(--step-0);
	}

	.review__author {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		padding-block-start: var(--space-s);
		border-block-start: 1px solid color-mix(in oklab, var(--color-text) 8%, transparent);
	}

	.review__initial {
		display: grid;
		flex: none;
		place-items: center;
		inline-size: 2.5rem;
		block-size: 2.5rem;
		border-radius: 50%;
		background: color-mix(in oklab, var(--color-primary) 16%, var(--color-surface));
		color: color-mix(in oklab, var(--color-primary) 65%, var(--color-ink));
		font-weight: 800;
	}

	.review__name {
		display: block;
		font-weight: 700;
		line-height: 1.3;
	}

	.review__meta {
		display: block;
		color: var(--color-text-muted);
		font-size: var(--step--1);
	}
</style>
