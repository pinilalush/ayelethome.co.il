---
import { pending } from '../lib/data.ts';

interface Props {
	label: string;
}

const { label } = Astro.props;

const style = {
	position: 'sticky',
	top: 0,
	'z-index': 1000,
	padding: '0.5rem 1rem',
	background: '#ffe08a',
	color: '#3a2a00',
	font: '600 0.875rem/1.4 system-ui, sans-serif',
	'text-align': 'center',
};
---

{
	pending.length > 0 && (
		<div role="note" style={style}>
			{label} ({pending.length})
		</div>
	)
}
