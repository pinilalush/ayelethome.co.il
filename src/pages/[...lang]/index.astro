---
import About from '../../components/About.astro';
import Area from '../../components/Area.astro';
import HeroGlow from '../../components/HeroGlow.astro';
import Pricing from '../../components/Pricing.astro';
import Services from '../../components/Services.astro';
import Base from '../../layouts/Base.astro';
import { getLocale, site } from '../../lib/data.ts';

export function getStaticPaths() {
	return site.languages.map((l) => ({
		params: { lang: l.default ? undefined : l.code },
		props: { code: l.code },
	}));
}

interface Props {
	code: string;
}

const { code } = Astro.props;
const { seo } = getLocale(code);
---

<Base code={code} title={seo.title} headerTone="dark">
	<HeroGlow code={code} />
	{site.config.sections.services && <Services code={code} />}
	{site.config.sections.pricing && site.business.pricing && <Pricing code={code} />}
	{site.config.sections.why && <About code={code} />}
	{site.config.sections.area && <Area code={code} />}
</Base>
