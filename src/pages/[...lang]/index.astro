---
import Base from '../../layouts/Base.astro';
import { getLocale, site } from '../../lib/data.ts';

export function getStaticPaths() {
	return site.languages.map((l) => ({
		params: { lang: l.default ? undefined : l.code },
		props: { code: l.code },
	}));
}

interface Props {
	code: string;
}

const { code } = Astro.props;
const { content, seo } = getLocale(code);
---

<Base code={code} title={seo.title}>
	<div class="container flow">
		<h1>{content.businessName}</h1>
		<p class="muted">{content.tagline}</p>
	</div>
</Base>
