---
import HeroGlow from '../../components/HeroGlow.astro';
import Base from '../../layouts/Base.astro';
import { getLocale, site } from '../../lib/data.ts';

export function getStaticPaths() {
	return site.languages.map((l) => ({
		params: { lang: l.default ? undefined : l.code },
		props: { code: l.code },
	}));
}

interface Props {
	code: string;
}

const { code } = Astro.props;
const { seo } = getLocale(code);
---

<Base code={code} title={seo.title} headerTone="dark">
	<HeroGlow code={code} />
</Base>
