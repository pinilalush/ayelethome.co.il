---
import Base from '../../layouts/Base.astro';
import { getLocale, pending, site } from '../../lib/data.ts';

export function getStaticPaths() {
	return site.languages.map((l) => ({
		params: { lang: l.default ? undefined : l.code },
		props: { code: l.code },
	}));
}

interface Props {
	code: string;
}

const { code } = Astro.props;
const { content, seo } = getLocale(code);
---

<Base code={code} title={seo.title}>
	<h1>{content.businessName}</h1>
	<p>{content.tagline}</p>
	<p>Placeholders left: {pending.length}</p>
</Base>
